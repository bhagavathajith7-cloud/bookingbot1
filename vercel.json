{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings.js"
    },
    {
      "source": "/api/add",
      "destination": "/api/add.js"
    },
    {
      "source": "/api/update",
      "destination": "/api/update.js"
    },
    {
      "source": "/api/delete",
      "destination": "/api/delete.js"
    }
  ]
}
